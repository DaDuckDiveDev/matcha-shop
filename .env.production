# Public URL of the deployed site, used for absolute Open Graph links.
# Empty on your own domain keeps the path root-relative.
VITE_SITE_URL=

# Brevo form action URL for the founding list (/join). Empty = preview, nothing is sent.
VITE_JOIN_ENDPOINT=

# The shop API, for example https://api.machiko.rs. The deploy workflows set it from the repository variable API_URL.
VITE_API_URL=
