{
  "name": "machiko-native",
  "version": "0.1.0",
  "main": "index.js",
  "dependencies": {
    "@expo-google-fonts/hanken-grotesk": "^0.4.3",
    "@expo-google-fonts/hina-mincho": "^0.4.1",
    "@expo/metro-runtime": "~58.0.17",
    "@react-native-async-storage/async-storage": "^2.2.0",
    "expo": "~58.0.25",
    "expo-font": "~58.0.12",
    "expo-status-bar": "~58.0.5",
    "react": "19.3.0",
    "react-dom": "^19.3.0",
    "react-native": "0.88.1",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-svg": "^15.16.0",
    "react-native-web": "^0.21.4"
  },
  "scripts": {
    "sync": "node scripts/sync-shared.mjs",
    "start": "npm run sync && expo start",
    "android": "npm run sync && expo start --android",
    "ios": "npm run sync && expo start --ios",
    "web": "npm run sync && expo start --web",
    "check": "npm run sync && expo export --platform android --platform ios --output-dir .export-check"
  },
  "private": true
}
