# Copy to .env and fill in.

# Where reservation requests are POSTed as JSON (Make.com webhook, a Google
# Apps Script, your own endpoint). Leave empty to keep them on the phone only.
VITE_RESERVE_WEBHOOK=

# After `npm run images:fetch`, set to 1 to serve photos from /photos
# instead of hotlinking Pexels.
VITE_PHOTOS_LOCAL=

# Brevo form action URL for the founding list at /join (double opt-in on in
# Brevo). Leave empty and the page is a preview that sends nothing.
VITE_JOIN_ENDPOINT=
