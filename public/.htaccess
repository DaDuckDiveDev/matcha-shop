# Machiko — routing, file types and caching for Apache hosts (SiteGround).

Options -Indexes

# File types older servers do not know.
AddType image/avif .avif
AddType font/woff2 .woff2
AddType application/manifest+json .webmanifest

# Every address that is not a file is a page of the app.
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /
  # One address: www.machiko.rs goes to machiko.rs.
  RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
  RewriteRule ^ https://%1%{REQUEST_URI} [R=301,L]
  RewriteRule ^index\.html$ - [L]
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule . /index.html [L]
</IfModule>

<IfModule mod_headers.c>
  # Browsers: keep to https, do not guess file types, do not show us inside
  # other sites, and say little about where a visitor came from.
  Header always set Strict-Transport-Security "max-age=15552000"
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"

  # Build files carry a fingerprint in their name: keep them for a year.
  <FilesMatch "\.(js|css|woff2)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  # Photographs and icons keep their names: a week.
  <FilesMatch "\.(avif|jpg|jpeg|png|svg|webp)$">
    Header set Cache-Control "public, max-age=604800"
  </FilesMatch>
  # The page itself, the app manifest and the service worker are always checked.
  <FilesMatch "\.(html|webmanifest|xml|txt)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
  <FilesMatch "^sw\.js$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>
