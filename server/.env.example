# Copy to .env for local work. On SiteGround, enter the same names under
# Site Tools > Node.js > Environment variables (never commit real values).

# --- database (Site Tools > MySQL: create a database and a user, give the user all rights on it)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=machiko
DB_USER=machiko
DB_PASSWORD=

# --- secrets: two long random strings (for example: openssl rand -hex 32)
ADMIN_TOKEN=          # the password for /admin and the exports
TOKEN_SECRET=         # signs the unsubscribe links

# --- the website this API serves
SITE_URL=https://machiko.rs
ALLOWED_ORIGINS=https://machiko.rs,https://www.machiko.rs

# --- email: the confirmation message for new sign-ups, and the note the shop gets for a reservation
# Use a mailbox on your own domain (Site Tools > Email > Accounts shows host and port).
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM="Machiko <hello@machiko.rs>"
NOTIFY_TO=hello@machiko.rs

# --- optional: copy every confirmed sign-up to a Brevo list, ready for campaigns
BREVO_API_KEY=
BREVO_LIST_ID=

# The platform sets PORT itself; 3000 is used when it does not.
# PORT=3000
